{
  "example_id": "stochastic",
  "artifact_type": "observation_stream",
  "protocol_version": "INTERFACE_THEORY_v0.1",

  "purpose": {
    "description": "Store observable noisy measurement streams generated from multiple stochastic processes.",
    "role": "Provide the interface-level data available to passive observers.",
    "usage": [
      "distribution overlap analysis",
      "interface comparison",
      "equivalence class construction"
    ]
  },

  "observation_model": {
    "equation": "y_t=x_t+eta_t",

    "noise": {
      "symbol": "eta_t",

      "distribution": "Normal(0,0.1)"
    },

    "access_level": {
      "latent_state": false,

      "observation": true
    }
  },

