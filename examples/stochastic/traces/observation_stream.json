  "stream_comparison": {
    "comparison_target": "single_observation_interface",

    "observable_statistics": {
      "mean_difference": 0.2714,

      "variance_difference": 0.223
    },

    "finite_sample_effect": {
      "overlap": true,

      "confidence": "sample_dependent"
    },

    "interpretation": "Individual observation histories may not reliably identify the generating stochastic process."
  },

  "observation_equivalence_tests": [
    {
      "test_id": "single_step_observation",

      "interface": "I_observation",

      "condition": "P(y_t|A)≈P(y_t|B)",

      "result": "ambiguous"
    },
    {
      "test_id": "short_history",

      "interface": "I_history_window_k5",

      "condition": "P(y_{t-4:t}|A)≈P(y_{t-4:t}|B)",

      "result": "partially_separated"
    },
    {
      "test_id": "long_history",

      "interface": "I_history_window_k50",

      "condition": "P(y_{t-49:t}|A)≈P(y_{t-49:t}|B)",

      "result": "separated"
    }
  ],

  "interface_visibility": {
    "visible": [
      "measurement_values",
      "temporal_patterns",
      "empirical_statistics"
    ],

    "hidden": [
      "latent_state",
      "process_noise",
      "true_generator"
    ]
  },

  "equivalence_metadata": {
    "candidate_classes": [
      "process_A",
      "process_B"
    ],

    "classing_basis": "observation_distribution",

    "ambiguity_source": "measurement_noise_and_finite_samples"
  },

  "validation": {
    "streams_generated": true,

    "observation_noise_applied": true,

    "latent_states_hidden": true,

    "interface_view_consistent": true
  },

  "decision": {
    "status": "READY",

    "meaning": "Observable stream artifact for stochastic identifiability evaluation."
  },

  "notes": [
    "This file represents what an observer receives, not the underlying reality.",
    "The benchmark tests whether additional interface structure can recover hidden distinctions.",
    "Observation similarity does not imply generator equivalence."
  ]
