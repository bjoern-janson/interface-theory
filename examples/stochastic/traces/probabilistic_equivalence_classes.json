      "failure_type": null
    },

    {
      "class_id": "EQ_distribution_interface_001",

      "interface": "I_distribution_estimator",

      "operator": {
        "equation": "O(x)=P_hat(y|x)"
      },

      "members": [
        "stochastic_process_A"
