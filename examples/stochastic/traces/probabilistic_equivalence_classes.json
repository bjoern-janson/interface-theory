{
  "example_id": "stochastic",
  "artifact_type": "probabilistic_equivalence_classes",
  "protocol_version": "INTERFACE_THEORY_v0.1",

  "purpose": {
    "description": "Construct stochastic equivalence classes by grouping latent processes with indistinguishable interface-level probability structures.",
    "role": "Measure whether an interface preserves target-relevant distinctions.",
    "principle": "Two latent processes belong to the same equivalence class when the interface cannot distinguish their observation distributions."
  },

  "formal_definition": {
    "interface_equivalence": {
      "condition": "x_A ~_I x_B iff P(O_I|x_A)=P(O_I|x_B)"
    },

    "target_preservation": {
      "condition": "x_A ~_I x_B implies P(L|x_A)=P(L|x_B)"
    },

    "failure_condition": {
      "condition": "x_A ~_I x_B and P(L|x_A)!=P(L|x_B)",

      "meaning": "Interface-induced stochastic aliasing"
    }
  },

  "equivalence_classes": [
    {
      "class_id": "EQ_single_observation_001",

      "interface": "I_observation",

      "operator": {
        "equation": "O(x_t)=y_t"
      },

      "members": [
        {
          "process_id": "stochastic_process_A",

          "generator": {
            "transition_parameter": 1.1,

            "process_noise": "Normal(0,0.05)"
          }
        },
        {
          "process_id": "stochastic_process_B",

          "generator": {
            "transition_parameter": 1.05,

            "process_noise": "Normal(0,0.1)"
          }
        }
      ],

      "observation_distribution": {
        "relationship": "overlapping",

        "similarity": "high"
      },

      "target_distributions": {
        "T_process_identification": {
          "A": "different",

          "B": "different"
        }
      },

      "equivalence_valid": true,

      "target_preserving": false,

      "failure_type": "distributional_aliasing"
    },

    {
      "class_id": "EQ_history_window_k5_001",

      "interface": "I_history_window_k5",

      "operator": {
        "equation": "O(x_t)=(y_{t-4},...,y_t)"
      },

      "members": [
        "stochastic_process_A",
        "stochastic_process_B"
      ],

      "observation_distribution": {
        "relationship": "partially_overlapping",

        "similarity": "medium"
      },

      "target_discrimination": {
