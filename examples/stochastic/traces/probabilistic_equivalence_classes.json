        "stochastic_process_A",
        "stochastic_process_B"
      ],

      "observation_distribution": {
        "relationship": "separated",

        "similarity": "low"
      },

      "target_discrimination": {
        "T_hidden_process_class": "successful",

        "T_process_identification": "improved"
      },

