{
  "example_id": "stochastic",
  "artifact_type": "factorization_check",
  "protocol_version": "INTERFACE_THEORY_v0.1",

  "purpose": {
    "description": "Verify whether stochastic interfaces preserve target-relevant probability distributions.",
    "role": "Determine when noisy observations collapse distinct latent processes.",
    "criterion": "Observation-equivalent distributions must remain target-equivalent distributions."
  },

  "formal_definition": {
    "latent_state": {
      "symbol": "x_t"
    },

    "interface_output": {
      "symbol": "O_I"
    },

    "target_distribution": {
      "symbol": "P(L|x_t)"
    },

    "stochastic_factorization_condition": {
      "statement": "exists P_hat such that P(L|x)=P_hat(L|O_I(x))",

      "equivalent_test": "P(O_I|x_A)=P(O_I|x_B) => P(L|x_A)=P(L|x_B)"
    }
  },

  "system": {
    "dynamics": {
      "equation": "x_{t+1}=1.1*x_t+epsilon_t"
    },

    "process_noise": {
      "distribution": "Normal(0,0.05)"
    },

    "observation": {
      "equation": "y_t=x_t+eta_t"
    },

    "observation_noise": {
      "distribution": "Normal(0,0.1)"
    }
  },

  "interfaces_checked": [
    {
      "interface_id": "I_observation",

      "operator": {
        "equation": "O(x_t)=y_t"
      },

      "targets": {
        "T_current_state_distribution": {
          "factorization": "conditional"
        },

        "T_future_state_distribution": {
          "factorization": false
        },

        "T_process_identification": {
          "factorization": false
        }
      },

      "counterexample": {
        "latent_process_A": {
          "state_distribution": {
            "mean": 1.0,

            "variance": 0.05
          }
        },

        "latent_process_B": {
          "state_distribution": {
            "mean": 1.1,

            "variance": 0.05
          }
        },

        "observation_overlap": {
          "high": true
        },

        "target_distribution_difference": {
          "exists": true
        }
      },

      "result": "fails_under_overlap"
    },

    {
      "interface_id": "I_history_window",

      "operator": {
        "equation": "O(x_t)=(y_{t-k},...,y_t)"
      },

      "window_tests": [
        {
          "window": 1,

          "state_estimation": "conditional",

          "process_identification": "fails"
        },
        {
          "window": 5,

          "state_estimation": "improved",

          "process_identification": "conditional"
        },
        {
          "window": 50,

          "state_estimation": "strong",

          "process_identification": "conditional"
        }
      ],

      "result": "sample_dependent"
    },

    {
      "interface_id": "I_distribution_estimator",

      "operator": {
        "equation": "O(x)=P_hat(y|x)"
      },

      "targets": {
        "T_current_state_distribution": {
          "factorization": true
        },

        "T_uncertainty_calibration": {
          "factorization": true
        },

        "T_hidden_process_class": {
          "factorization": true
        }
      },

      "assumptions": [
        "sufficient samples",
        "stable distribution"
      ],

      "result": "passes"
    },

    {
      "interface_id": "I_belief_state",

      "operator": {
        "equation": "O(x_t)=P(x_t|y_{0:t})"
      },

      "targets": {
        "T_current_state_distribution": {
          "factorization": true
        },

        "T_future_state_distribution": {
          "factorization": true
        }
      },

      "assumptions": [
        "correct transition model",
        "correct observation model"
      ],

      "failure_modes": [
        "model_mismatch"
      ],

      "result": "passes_under_model"
    },

    {
      "interface_id": "I_intervention",

      "operator": {
        "equation": "O(x_t,u_t)=P(y_{t+1}|do(u_t),x_t)"
      },

      "targets": {
        "T_process_identification": {
          "factorization": true
        },

        "T_hidden_process_class": {
          "factorization": true
        }
      },

      "assumptions": [
        "available interventions",
        "sufficient excitation"
      ],

      "result": "passes"
    }
  ],

  "failure_taxonomy": {
    "distributional_aliasing": {
      "definition": "Different latent processes produce indistinguishable observation distributions."
    },

    "finite_sample_error": {
      "definition": "Limited samples prevent reliable distribution estimation."
    },

    "model_mismatch": {
      "definition": "Belief representation becomes incorrect when assumptions fail."
    },

    "uncertainty_collapse": {
      "definition": "Interface represents a point estimate when uncertainty is target-relevant."
    }
  },

  "global_findings": {
    "noise_is_not_information_loss": true,

    "noise_changes_identification_requirements": true,

    "sufficient_interface_properties": [
      "distribution preservation",
      "uncertainty representation",
      "causal separation"
    ]
  },

  "comparison_to_previous_examples": {
    "linear": {
      "failure": "same observation, different target"
    },

    "hidden_state": {
      "failure": "latent variables inaccessible"
    },

    "delay": {
      "failure": "information arrives at wrong temporal position"
    },

    "stochastic": {
      "failure": "observation distributions overlap"
    }
  },

  "validation": {
    "factorization_tests_completed": true,

    "distributional_counterexamples_generated": true,

    "interface_boundaries_verified": true
  },

  "decision": {
    "status": "PASSED",

    "meaning": "Stochastic factorization boundaries have been verified across candidate interfaces."
  },

  "notes": [
    "The stochastic benchmark extends equivalence from values to distributions.",
    "A sufficient interface preserves uncertainty whenever uncertainty affects the target.",
    "The benchmark separates noisy sensing from inadequate representation."
  ]
}
