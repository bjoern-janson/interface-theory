{
  "example_id": "stochastic",
  "artifact_type": "interface_definitions",
  "protocol_version": "INTERFACE_THEORY_v0.1",

  "purpose": {
    "description": "Define candidate interfaces for evaluating identifiability under stochastic dynamics and noisy observations.",
    "role": "Compare interfaces by their ability to preserve probabilistic distinctions.",
    "principle": "An interface is sufficient when the target distribution factors through the available information."
  },

  "formal_definition": {
    "interface_operator": {
      "symbol": "O_I"
    },

    "target_distribution": {
      "symbol": "P(L|x)"
    },

    "stochastic_factorization_condition": {
      "statement": "exists P_hat such that P(L|x)=P_hat(L|O_I(x))",

      "failure_condition": "P(O_I|x_A)=P(O_I|x_B) but P(L|x_A)!=P(L|x_B)"
    }
  },

  "interfaces": [
    {
      "interface_id": "I_observation",

      "name": "Raw noisy observation",

      "description": "Observer receives only the current noisy measurement.",

      "operator": {
        "equation": "O_I(x_t)=y_t=x_t+eta_t"
      },

      "inputs": {
        "observation": true,

        "history": false,

        "belief_state": false,

        "model": false,

        "intervention": false
      },

      "information_content": {
        "point_estimate": true,

        "uncertainty": false,

        "transition_structure": false
      },

      "complexity": {
        "memory": 0,

        "model_requirement": "none",

        "computation": "low"
      },

      "expected_targets": {
        "current_state_estimation": "conditional",

        "future_distribution_prediction": "insufficient",

        "process_identification": "insufficient"
      },

      "failure_modes": [
        "measurement_noise",
        "distributional_overlap"
      ],

      "status": "baseline"
    },

    {
      "interface_id": "I_history_window",

      "name": "Temporal observation history",

      "description": "Observer receives a sequence of noisy measurements.",

      "operator": {
        "equation": "O_I(x_t)=(y_{t-k},...,y_t)"
      },

      "parameters": {
        "window_sizes": [
          1,
          5,
          10,
          50
        ]
      },

      "inputs": {
        "observation": true,

        "history": true,

        "belief_state": false,

        "model": false,

        "intervention": false
      },

      "information_content": {
        "temporal_statistics": true,

        "noise_averaging": true,

        "latent_state_distribution": partial
      },

      "complexity": {
        "memory": "k",

        "model_requirement": "none",

        "computation": "medium"
      },

      "expected_targets": {
        "current_state_estimation": "improved",

        "future_distribution_prediction": "conditional",

        "process_identification": "conditional"
      },

      "failure_modes": [
        "insufficient_samples",
        "nonstationarity"
      ],

      "status": "history_dependent"
    },

    {
      "interface_id": "I_belief_state",

      "name": "Posterior belief interface",

      "description": "Observer maintains a probability distribution over latent states.",

      "operator": {
        "equation": "O_I(x_t)=P(x_t|y_{0:t})"
      },

      "inputs": {
        "observation": true,

        "history": true,

        "belief_state": true,

        "model": true,

        "intervention": false
      },

      "information_content": {
        "state_distribution": true,

        "uncertainty": true,

        "confidence": true
      },

      "complexity": {
        "memory": "compressed_history",

        "model_requirement": "required",

        "computation": "high"
      },

      "expected_targets": {
        "current_state_estimation": "sufficient",

        "future_distribution_prediction": "sufficient",

        "process_identification": "conditional"
      },

      "failure_modes": [
        "model_mismatch",
        "incorrect_prior"
      ],

      "status": "probabilistically_complete_under_model"
    },

    {
      "interface_id": "I_distribution_estimator",

      "name": "Empirical distribution interface",

      "description": "Observer estimates observation distributions from repeated samples.",

      "operator": {
        "equation": "O_I(x)=P_hat(y|x)"
      },

      "inputs": {
        "observation": true,

        "history": true,

        "samples": true,

        "model": false,

        "intervention": false
      },

      "information_content": {
        "observation_distribution": true,

        "uncertainty": true,

        "single_state_access": false
      },

      "complexity": {
        "memory": "sample_buffer",

        "model_requirement": "none",

        "computation": "medium"
      },

      "expected_targets": {
        "current_state_estimation": "conditional",

        "future_distribution_prediction": "conditional",

        "process_identification": "conditional"
      },

      "failure_modes": [
        "finite_sample_error"
      ],

      "status": "distribution_preserving"
    },

    {
      "interface_id": "I_intervention",

      "name": "Active stochastic probing",

      "description": "Observer perturbs the system to distinguish stochastic processes.",

      "operator": {
        "equation": "O_I(x_t,u_t)=P(y_{t+1}|do(u_t),x_t)"
      },

      "inputs": {
        "observation": true,

        "history": true,

        "belief_state": false,

        "model": false,

        "intervention": true
      },

      "information_content": {
        "causal_response": true,

        "transition_effects": true,

        "uncertainty_reduction": true
      },

      "complexity": {
        "memory": "variable",

        "model_requirement": "none",

        "control_requirement": "required",

        "computation": "high"
      },

      "expected_targets": {
        "current_state_estimation": "improved",

        "future_distribution_prediction": "sufficient",

        "process_identification": "sufficient"
      },

      "failure_modes": [
        "limited_control",
        "weak_signal"
      ],

      "status": "active_identification"
    }
  ],

  "interface_ordering": {
    "complexity_rank": [
      "I_observation",
      "I_history_window",
      "I_distribution_estimator",
      "I_belief_state",
      "I_intervention"
    ],

    "information_rank": [
      "I_observation",
      "I_history_window",
      "I_distribution_estimator",
      "I_belief_state",
      "I_intervention"
    ]
  },

  "comparison_summary": {
    "observation_only": {
      "strength": "simple measurements",

      "limitation": "cannot represent uncertainty"
    },

    "history": {
      "strength": "reduces stochastic ambiguity",

      "limitation": "requires samples"
    },

    "belief_state": {
      "strength": "explicit uncertainty representation",

      "limitation": "depends on model assumptions"
    },

    "intervention": {
      "strength": "creates causal separation",

      "limitation": "requires active access"
    }
  },

  "validation": {
    "interfaces_defined": true,

    "probabilistic_factorization_defined": true,

    "complexity_order_defined": true
  },

  "decision": {
    "status": "READY",

    "meaning": "Candidate interfaces for stochastic identifiability benchmark."
  },

  "notes": [
    "Stochastic interfaces are evaluated by distributions rather than exact observations.",
    "Belief states are treated as compressed probabilistic interfaces.",
    "The benchmark distinguishes uncertainty preservation from raw information quantity."
  ]
}
