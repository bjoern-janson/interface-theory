{
  "example_id": "hidden_state",
  "artifact_type": "factorization_check",
  "protocol_version": "INTERFACE_THEORY_v0.1",

  "purpose": {
    "description": "Verify whether candidate interfaces preserve enough information to compute hidden-state targets.",
    "role": "Test whether latent-state observation boundaries satisfy exact factorization.",
    "criterion": "Observation-equivalent states must remain target-equivalent."
  },

  "formal_definition": {
    "system_state": {
      "symbol": "z_t",

      "components": [
        "x_t",
        "h_t"
      ]
    },

    "observation_operator": {
      "definition": "O(z_t)=Cz_t"
    },

    "factorization_condition": {
      "statement": "exists L_hat such that L=L_hat o O",

      "equivalent_test": "O(z_a)=O(z_b) => L(z_a)=L(z_b)"
    }
  },

  "system": {
    "transition_matrix": [
      [
        1.0,
        0.5
      ],
      [
        0.0,
        0.95
      ]
    ],

    "horizon": 10,

    "targets_tested": [
      "T_current_observable",
      "T_hidden_state",
      "T_future_observable",
      "T_future_hidden",
      "T_latent_trajectory"
    ]
  },

  "interfaces": [
    {
      "interface_id": "I_observation_only",

      "observation_matrix": [
        [
          1.0,
          0.0
        ]
      ],

      "rank": 1,

      "target_results": {
        "T_current_observable": {
          "factorization": true
        },

        "T_hidden_state": {
          "factorization": false
        },

        "T_future_observable": {
          "factorization": false
        },

        "T_future_hidden": {
          "factorization": false
        },

        "T_latent_trajectory": {
          "factorization": false
        }
      },

      "counterexample": {
        "state_A": [
          1.0,
          0.0
        ],

        "state_B": [
          1.0,
          1.0
        ],

        "observation_equivalence": {
          "O_A": [
            1.0
          ],

          "O_B": [
            1.0
          ]
        },

        "future_targets": {
          "T_future_observable": {
            "A": 1.0,

            "B": 6.013
          },

          "T_hidden_state": {
            "A": 0.0,

            "B": 0.5987
          }
        }
      },

      "failure_mode": "hidden_state_aliasing",

      "result": "insufficient_for_latent_targets"
    },

    {
      "interface_id": "I_history_window",

      "observation_operator": {
        "definition": "O(z_t)=(y_{t-k},...,y_t)",

        "tested_windows": [
          1,
          2,
          5,
          10
        ]
      },

      "target_results": {
        "T_current_observable": {
          "factorization": true
        },

        "T_hidden_state": {
          "factorization": "window_dependent"
        },

        "T_future_observable": {
          "factorization": "window_dependent"
        },

        "T_future_hidden": {
          "factorization": "window_dependent"
        },

        "T_latent_trajectory": {
          "factorization": false
        }
      },

      "analysis": {
        "success_condition": "history uniquely identifies latent state",

        "failure_condition": "multiple hidden trajectories share same observation history"
      },

      "result": "conditionally_sufficient"
    },

    {
      "interface_id": "I_full_state",

      "observation_matrix": [
        [
          1.0,
          0.0
        ],
        [
          0.0,
          1.0
        ]
      ],

      "rank": 2,

      "target_results": {
        "T_current_observable": {
          "factorization": true
        },

        "T_hidden_state": {
          "factorization": true
        },

        "T_future_observable": {
          "factorization": true
        },

        "T_future_hidden": {
          "factorization": true
        },

        "T_latent_trajectory": {
          "factorization": true
        }
      },

      "result": "sufficient"
    },

    {
      "interface_id": "I_intervention",

      "observation_operator": {
        "definition": "O(z_t,u_t)=response(z_t,do(u_t))"
      },

      "target_results": {
        "T_hidden_state": {
          "factorization": "improved"
        },

        "T_future_observable": {
          "factorization": true
        },

        "T_future_hidden": {
          "factorization": "improved"
        }
      },

      "analysis": {
        "mechanism": "controlled perturbations separate observationally equivalent latent states"
      },

      "result": "active_identification"
    }
  ],

  "global_findings": {
    "observation_only": {
      "status": "fails",

      "reason": "Hidden-state distinctions are removed at the interface."
    },

    "history": {
      "status": "conditional",

      "reason": "Dynamics can encode latent information into observable trajectories."
    },

    "intervention": {
      "status": "improved",

      "reason": "Additional causal channel increases identifiability."
    },

    "full_state": {
      "status": "complete",

      "reason": "No information boundary remains."
    }
  },

  "validation": {
    "equivalence_checks_complete": true,

    "counterexamples_generated": true,

    "target_divergence_verified": true,

    "factorization_boundary_verified": true
  },

  "decision": {
    "status": "PASSED",

    "meaning": "Hidden-state factorization confirms that identifiability depends on preserved causal pathways rather than direct visibility."
  },

  "notes": [
    "A hidden variable may be recoverable through time even when inaccessible instantaneously.",
    "The benchmark distinguishes hiddenness from non-identifiability.",
    "Interface quality is measured by target preservation, not observation dimensionality alone."
  ]
}
