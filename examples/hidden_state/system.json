{
  "example_id": "hidden_state",
  "artifact_type": "system_definition",
  "protocol_version": "INTERFACE_THEORY_v0.1",

  "metadata": {
    "name": "Canonical Hidden-State Dynamical System",
    "description": "Minimal latent-state system where hidden variables influence future observable behavior.",
    "purpose": "Test whether interfaces can identify target-relevant latent structure without direct hidden-state access."
  },

  "system_class": {
    "family": "partially_observed_linear_dynamical_system",

    "stationarity": "stationary",

    "determinism": "deterministic",

    "state_dimension": 2,

    "observable_dimension": 1,

    "latent_dimension": 1
  },

  "state": {
    "symbol": "z_t",

    "space": "R^2",

    "components": [
      {
        "index": 0,

        "name": "observable_state",

        "symbol": "x_t",

        "role": "directly measured component"
      },
      {
        "index": 1,

        "name": "hidden_state",

        "symbol": "h_t",

        "role": "latent causal component"
      }
    ],

    "representation": {
      "vector": [
        "x_t",
        "h_t"
      ]
    }
  },

  "dynamics": {
    "equation": "z_{t+1}=Az_t",

    "transition_matrix": [
      [
        1.0,
        0.5
      ],
      [
        0.0,
        0.95
      ]
    ],

    "properties": {
      "linear": true,

      "time_invariant": true,

      "deterministic": true,

      "hidden_to_observable_coupling": true
    },

    "causal_dependencies": {
      "x_t": [
        "x_{t+1}"
      ],

      "h_t": [
        "h_{t+1}",
        "x_{t+1}"
      ]
    },

    "interpretation": "The hidden state persists over time and influences future observations."
  },

  "observation_model": {
    "general_form": "y_t=Cz_t",

    "default_interface": {
      "id": "I_observation_only",

      "matrix": [
        [
          1.0,
          0.0
        ]
      ],

      "equation": "y_t=x_t"
    },

    "available_interfaces": [
      "I_observation_only",
      "I_history_window",
      "I_full_state",
      "I_intervention"
    ]
  },

  "initial_conditions": {
    "state_space": "R^2",

    "sampling": {
      "distribution": "uniform",

      "range": [
        -1.0,
        1.0
      ]
    },

    "paired_counterexample_generation": {
      "enabled": true,

      "constraint": "same_observation_different_hidden_state"
    }
  },

  "trajectory_generation": {
    "default_horizon": 10,

    "trajectory_definition": "z_0,z_1,...,z_T",

    "recurrence": "z_{t+1}=Az_t"
  },

  "hidden_state_properties": {
    "persistence": 0.95,

    "direct_observability": false,

    "dynamic_observability": true,

    "description": "The hidden variable cannot be read directly but can influence observable trajectories."
  },

  "benchmark_questions": [
    {
      "id": "Q1",

      "question": "Can instantaneous observations identify the hidden state?",

      "expected": "no"
    },
    {
      "id": "Q2",

      "question": "Can temporal history recover hidden state?",

      "expected": "target_dependent"
    },
    {
      "id": "Q3",

      "question": "Can intervention improve hidden-state identifiability?",

      "expected": "yes"
    }
  ],

  "expected_behavior": {
    "I_observation_only": {
      "factorization": false,

      "failure_mode": "hidden_state_aliasing"
    },

    "I_history_window": {
      "factorization": "conditional",

      "dependency": "window_length_and_dynamics"
    },

    "I_full_state": {
      "factorization": true,

      "reason": "Complete latent state available."
    },

    "I_intervention": {
      "factorization": "improved",

      "reason": "Active perturbations create additional causal information."
    }
  },

  "validation": {
    "dimension_check": true,

    "coupling_verified": true,

    "hidden_state_persistence_verified": true,

    "observation_boundary_verified": true
  },

  "decision": {
    "status": "ACTIVE",

    "meaning": "Canonical environment for hidden-state interface identifiability experiments."
  },

  "notes": [
    "The system is intentionally minimal: one visible and one hidden dimension are sufficient to demonstrate latent-state ambiguity.",
    "The hidden variable is not noise; it is a causal state component.",
    "This benchmark separates direct observability from dynamic identifiability."
  ]
}
