  "interface_partition_analysis": {
    "I_observation": {
      "partition": "observation_values",

      "problem": "merges causal regimes"
    },

    "I_history_window": {
      "partition": "recent_sequences",

      "problem": "history may contain obsolete dynamics"
    },

    "I_stationary_model": {
      "partition": "fixed_transition_models",

