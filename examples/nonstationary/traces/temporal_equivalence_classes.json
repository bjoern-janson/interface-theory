{
  "example_id": "nonstationary",
  "artifact_type": "temporal_equivalence_classes",
  "trace_id": "temporal_equivalence_classes",
  "protocol_version": "INTERFACE_THEORY_v0.1",

  "purpose": {
    "description": "Define temporal equivalence classes showing when observations appear identical while future causal behavior differs.",
    "role": "Identify failures caused by collapsing states across changing regimes.",
    "principle": "Temporal equivalence requires preserving distinctions that remain predictive after environmental change."
  },

  "formal_definition": {
    "interface_equivalence": {
      "condition": "O_I(x_t,z_t)=O_I(x_{t+k},z_{t+k})"
    },

    "target_equivalence": {
      "condition": "P(L_t|x_t,z_t)=P(L_{t+k}|x_{t+k},z_{t+k})"
    },

    "valid_class": {
      "condition": "interface_equivalence AND target_equivalence"
    },

    "invalid_class": {
      "condition": "interface_equivalence AND NOT target_equivalence",

      "meaning": "Temporal aliasing caused by nonstationarity."
    }
  },

  "trace_context": {
    "system": "regime_switching_dynamics",

    "regimes": [
      "growth",
      "stabilization",
      "inversion"
    ],

    "hidden_variable": "z_t",

    "observable_variable": "y_t"
  },

