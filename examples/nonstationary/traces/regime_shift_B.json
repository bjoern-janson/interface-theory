{
  "example_id": "nonstationary",
  "artifact_type": "trace",
  "trace_id": "regime_shift_B",
  "protocol_version": "INTERFACE_THEORY_v0.1",

  "purpose": {
    "description": "Provide a delayed and ambiguous regime transition trace for evaluating whether interfaces can distinguish gradual drift from stochastic variation.",
    "role": "Test adaptive interfaces under weak evidence of changing causal structure.",
    "principle": "A regime change may be identifiable only through accumulated temporal evidence."
  },

  "scenario": {
    "name": "gradual_stabilization_to_inversion_shift",

    "type": "gradual_regime_drift",

    "description": "The system slowly transitions from a damping regime into an inverted regime. No single observation reveals the change."
  },

  "system": {
    "state_variable": "x_t",

    "regime_variable": "z_t",

    "observation_variable": "y_t",

    "transition_equations": {
      "stabilization": "x_{t+1}=0.8*x_t+epsilon_t",

      "inversion": "x_{t+1}=-0.5*x_t+epsilon_t"
    },

    "observation_equation": {
      "all_regimes": "y_t=x_t+eta_t"
    }
  },

  "initial_conditions": {
    "time": 0,

    "state": {
      "value": 5.0
    },

    "regime": {
      "value": "stabilization"
    }
  },

  "regime_schedule": {
    "type": "continuous_parameter_drift",

    "transition_parameter": {
      "symbol": "a_t",

      "equation": "x_{t+1}=a_t*x_t+epsilon_t"
    },

    "trajectory": [
      {
        "time": 0,

        "a": 0.8,

        "regime_class": "stabilization"
      },
      {
        "time": 25,

        "a": 0.5,

        "regime_class": "weak_stabilization"
      },
      {
        "time": 50,

        "a": 0.0,

        "regime_class": "transition_boundary"
      },
      {
        "time": 75,

        "a": -0.25,

        "regime_class": "weak_inversion"
      },
      {
        "time": 100,

        "a": -0.5,

        "regime_class": "inversion"
      }
    ]
  },

  "events": [
    {
      "time": 0,

      "event": "initialization",

      "latent_state": {
        "x": 5.0
      },

      "regime": "stabilization",

      "observation": {
        "y": 4.96
      }
    },

    {
      "time": 30,

      "event": "weak_drift",

      "description": "Dynamics have changed but remain statistically similar to previous behavior.",

      "detection_difficulty": "high"
    },

    {
      "time": 50,

      "event": "causal_boundary_crossing",

      "description": "The system no longer has a positive feedback coefficient.",

      "observation_visibility": "low"
    },

    {
      "time": 75,

      "event": "negative_dynamics_emerge",

      "description": "Future predictions begin diverging from stationary assumptions."
    },

    {
      "time": 100,

      "event": "fully_inverted_regime",

      "regime": "inversion",

      "model_failure": "stationary_assumption_invalid"
    }
  ],

  "trace": {
    "length": 120,

    "sampling_interval": 1,

    "segments": [
      {
        "segment_id": "stable_phase",

        "time_range": [
          0,
          29
        ],

        "regime": "stabilization",

        "dynamics": {
          "a": 0.8
        },

        "interface_expectation": {
          "stationary_model": "valid"
        }
      },
      {
        "segment_id": "drift_phase",

        "time_range": [
          30,
          74
        ],

        "regime": "unknown_transition",

        "dynamics": {
          "a": "changing"
        },

        "interface_expectation": {
          "change_detection_required": true
        }
      },
      {
        "segment_id": "inversion_phase",

        "time_range": [
          75,
          119
        ],

        "regime": "inversion",

        "dynamics": {
          "a": -0.5
        },

        "interface_expectation": {
          "stationary_model": "invalid",

          "adaptive_model": "required"
        }
      }
    ]
  },

  "observations": [
    {
      "time": 0,

      "x": 5.0,

      "z": "stabilization",

      "y": 4.96
    },
    {
      "time": 20,

      "x": 2.1,

      "z": "stabilization",

      "y": 2.08
    },
    {
      "time": 40,

      "x": 1.1,

      "z": "drifting",

      "y": 1.13
    },
    {
      "time": 60,

      "x": 0.7,

      "z": "transition_boundary",

      "y": 0.69
    },
    {
      "time": 80,

      "x": -0.3,

      "z": "weak_inversion",

      "y": -0.28
    },
    {
      "time": 100,

      "x": 0.15,

      "z": "inversion",

      "y": 0.17
    },
    {
      "time": 119,

      "x": -0.08,

      "z": "inversion",

      "y": -0.06
    }
  ],

  "interface_evaluation": {
    "I_observation": {
      "result": "failure",

      "reason": "Individual observations do not contain regime information."
    },

    "I_history_window": {
      "result": "window_dependent",

      "reason": "Short windows miss drift; long windows retain obsolete assumptions."
    },

    "I_stationary_model": {
      "result": "failure",

      "reason": "Cannot represent continuously changing dynamics."
    },

    "I_change_detector": {
      "result": "conditional",

      "reason": "Requires sensitivity to weak distributional drift."
    },

    "I_adaptive_belief": {
      "result": "success",

      "reason": "Can represent uncertainty over intermediate regimes."
    },

    "I_intervention": {
      "result": "success",

      "reason": "Active perturbations can reveal changing response dynamics."
    }
  },

  "metrics": {
    "drift_start": 30,

    "boundary_crossing": 50,

    "clear_failure_point": 75,

    "full_transition": 100
  },

  "equivalence_classes": {
    "early_phase": {
      "class": "stationary_stabilization"
    },

    "middle_phase": {
      "class": "ambiguous_transition"
    },

    "late_phase": {
      "class": "inverted_dynamics"
    },

    "failure_case": {
      "observation_similarity": true,

      "transition_similarity": false
    }
  },

  "validation": {
    "gradual_shift_present": true,

    "weak_signal_condition_present": true,

    "stationary_failure_testable": true,

    "adaptive_uncertainty_testable": true
  },

  "decision": {
    "status": "READY",

    "meaning": "Canonical gradual regime drift trace for nonstationary adaptation evaluation."
  },

  "notes": [
    "This trace separates sudden change detection from continuous adaptation.",
    "The key challenge is deciding when accumulated small deviations indicate a new causal regime.",
    "Adaptive interfaces must balance stability against responsiveness."
  ]
}
