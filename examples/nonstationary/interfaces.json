{
  "example_id": "nonstationary",
  "artifact_type": "interface_definitions",
  "protocol_version": "INTERFACE_THEORY_v0.1",

  "purpose": {
    "description": "Define candidate interfaces for evaluating adaptation under changing system dynamics.",
    "role": "Compare representations by their ability to preserve state, regime, and transition validity.",
    "principle": "A nonstationary interface must preserve information required to detect when previous assumptions become invalid."
  },

  "formal_definition": {
    "interface_operator": {
      "symbol": "O_I"
    },

    "target_distribution": {
      "symbol": "P(L_t|x_t,z_t)"
    },

    "nonstationary_factorization_condition": {
      "statement": "exists P_hat such that P(L_t|x_t,z_t)=P_hat(L_t|O_I(x_t))",

      "extended_condition": "O_I must preserve distinctions between states requiring different regime-dependent predictions."
    },

    "failure_condition": {
      "statement": "O_I(x_t)=O_I(x_{t+k}) but P(L_t)!=P(L_{t+k})",

      "meaning": "The interface treats outdated and current causal conditions as equivalent."
    }
  },

  "interfaces": [
    {
      "interface_id": "I_observation",

      "name": "Raw observation",

      "description": "Current noisy measurement without temporal or causal context.",

      "operator": {
        "equation": "O_I(x_t)=y_t"
      },

      "inputs": {
        "current_observation": true,

        "history": false,

        "regime_estimate": false,

        "model": false,

        "intervention": false
      },

      "information_content": {
        "state_signal": true,

        "regime_information": false,

        "change_detection": false
      },

      "complexity": {
        "memory": 0,

        "model_requirement": "none",

        "computation": "low"
      },

      "expected_targets": {
        "state_estimation": "conditional",

        "regime_estimation": "insufficient",

        "future_prediction": "insufficient",

        "adaptation_latency": "poor"
      },

      "failure_modes": [
        "hidden_regime_shift",
        "stale_assumption"
      ],

      "status": "baseline"
    },

    {
      "interface_id": "I_history_window",

      "name": "Finite temporal history",

      "description": "Recent observations used to infer current dynamics.",

      "operator": {
        "equation": "O_I(x_t)=(y_{t-k},...,y_t)"
      },

      "parameters": {
        "window_sizes": [
          5,
          20,
          100
        ]
      },

      "inputs": {
        "current_observation": true,

        "history": true,

        "regime_estimate": false,

        "model": false
      },

      "information_content": {
        "temporal_pattern": true,

        "regime_change_signal": partial,

        "stale_information": possible
      },

      "complexity": {
        "memory": "k",

        "model_requirement": "none",

        "computation": "medium"
      },

      "expected_targets": {
        "state_estimation": "improved",

        "regime_estimation": "conditional",

        "future_prediction": "conditional",

        "adaptation_latency": "window_dependent"
      },

      "failure_modes": [
        "long_window_staleness",
        "short_window_noise"
      ],

      "status": "history_dependent"
    },

    {
      "interface_id": "I_stationary_model",

      "name": "Fixed dynamics model",

      "description": "Learns one transition function and assumes environmental stability.",

      "operator": {
        "equation": "O_I(x_t)=P(x_{t+1}|x_t)"
      },

      "inputs": {
        "current_observation": true,

        "history": true,

        "regime_estimate": false,

        "adaptive_update": false
      },

      "information_content": {
        "state_prediction": true,

        "regime_information": false,

        "model_uncertainty": false
      },

      "complexity": {
        "memory": "compressed",

        "model_requirement": "required",

        "computation": "medium"
      },

      "expected_targets": {
        "state_estimation": "good_before_shift",

        "regime_estimation": "fails",

        "future_prediction": "fails_after_shift",

        "adaptation_latency": "high"
      },

      "failure_modes": [
        "model_obsolescence",
        "false_stability"
      ],

      "status": "stationary_baseline"
    },

    {
      "interface_id": "I_change_detector",

      "name": "Regime change detector",

      "description": "Maintains evidence about whether the current generating process has changed.",

      "operator": {
        "equation": "O_I(x_t)=P(z_t|y_{0:t})"
      },

      "inputs": {
        "current_observation": true,

        "history": true,

        "regime_estimate": true,

        "model": partial
      },

      "information_content": {
        "regime_probability": true,

        "change_signal": true,

        "state_uncertainty": partial
      },

      "complexity": {
        "memory": "compressed_history",

        "model_requirement": "required",

        "computation": "high"
      },

      "expected_targets": {
        "state_estimation": "improved",

        "regime_estimation": "sufficient",

        "future_prediction": "improved",

        "adaptation_latency": "low"
      },

      "failure_modes": [
        "weak_shift_signal",
        "false_positive_detection"
      ],

      "status": "adaptive_detection"
    },

    {
      "interface_id": "I_adaptive_belief",

      "name": "Joint state-regime belief",

      "description": "Maintains uncertainty over both latent state and active environment regime.",

      "operator": {
        "equation": "O_I(x_t)=P(x_t,z_t|y_{0:t})"
      },

      "inputs": {
        "current_observation": true,

        "history": true,

        "regime_estimate": true,

        "model": true
      },

      "information_content": {
        "state_distribution": true,

        "regime_distribution": true,

        "uncertainty": true,

        "model_validity": true
      },

      "complexity": {
        "memory": "compressed",

        "model_requirement": "required",

        "computation": "high"
      },

      "expected_targets": {
        "state_estimation": "sufficient",

        "regime_estimation": "sufficient",

        "future_prediction": "sufficient",

        "adaptation_latency": "optimal"
      },

      "failure_modes": [
        "incorrect_regime_model",
        "unmodeled_regime"
      ],

      "status": "adaptive_interface"
    },

    {
      "interface_id": "I_intervention",

      "name": "Active probing interface",

      "description": "Uses controlled perturbations to identify the current causal regime.",

      "operator": {
        "equation": "O_I(x_t,u_t)=P(y_{t+1}|do(u_t),x_t)"
      },

      "inputs": {
        "current_observation": true,

        "history": true,

        "intervention": true,

        "regime_estimate": false
      },

      "information_content": {
        "causal_response": true,

        "regime_separation": true,

        "uncertainty_reduction": true
      },

      "complexity": {
        "memory": "variable",

        "model_requirement": "none",

        "control_requirement": "required",

        "computation": "high"
      },

      "expected_targets": {
        "state_estimation": "improved",

        "regime_estimation": "sufficient",

        "future_prediction": "sufficient",

        "adaptation_latency": "low"
      },

      "failure_modes": [
        "limited_control",
        "unsafe_exploration"
      ],

      "status": "active_adaptation"
    }
  ],

  "interface_ordering": {
    "complexity_rank": [
      "I_observation",
      "I_history_window",
      "I_stationary_model",
      "I_change_detector",
      "I_adaptive_belief",
      "I_intervention"
    ],

    "adaptation_rank": [
      "I_stationary_model",
      "I_observation",
      "I_history_window",
      "I_change_detector",
      "I_intervention",
      "I_adaptive_belief"
    ]
  },

  "comparison_summary": {
    "observation_only": {
      "strength": "minimal sensing",

      "limitation": "cannot know when assumptions fail"
    },

    "history": {
      "strength": "detects temporal drift",

      "limitation": "contains stale information"
    },

    "stationary_model": {
      "strength": "efficient prediction",

      "limitation": "breaks after regime changes"
    },

    "change_detector": {
      "strength": "tracks environmental validity",

      "limitation": "requires reliable shift evidence"
    },

    "adaptive_belief": {
      "strength": "jointly represents uncertainty over state and regime",

      "limitation": "requires richer modeling"
    },

    "intervention": {
      "strength": "actively separates causal regimes",

      "limitation": "requires system access"
    }
  },

  "validation": {
    "interfaces_defined": true,

    "regime_tracking_defined": true,

    "adaptation_properties_defined": true
  },

  "decision": {
    "status": "READY",

    "meaning": "Candidate interfaces for nonstationary adaptive identifiability benchmark."
  },

  "notes": [
    "The critical variable is not only what state the system is in, but whether the model remains valid.",
    "Adaptive interfaces must preserve information about changing causal structure.",
    "Nonstationary failure is representation staleness rather than simple information absence."
  ]
}
