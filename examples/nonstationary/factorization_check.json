{
  "example_id": "nonstationary",
  "artifact_type": "factorization_check",
  "protocol_version": "INTERFACE_THEORY_v0.1",

  "purpose": {
    "description": "Verify whether candidate interfaces preserve target-relevant information when system dynamics change over time.",
    "role": "Test whether an interface can factorize predictions through a representation that remains valid across regime transitions.",
    "principle": "A sufficient interface must preserve distinctions between latent states with different future consequences under different regimes."
  },

  "formal_definition": {
    "latent_state": {
      "symbol": "x_t"
    },

    "regime_state": {
      "symbol": "z_t"
    },

    "interface_output": {
      "symbol": "O_I"
    },

    "target_distribution": {
      "symbol": "P(L_t|x_t,z_t)"
    },

    "factorization_condition": {
      "statement": "P(L_t|x_t,z_t)=P_hat(L_t|O_I(x_t))",

      "extended_condition": "O_I must preserve both state-relevant and regime-relevant distinctions."
    },

    "failure_condition": {
      "statement": "P(O_I|x_A,z_A)=P(O_I|x_B,z_B) while P(L|x_A,z_A)!=P(L|x_B,z_B)",

      "meaning": "Interface-induced regime aliasing."
    }
  },

  "system_context": {
    "dynamics": {
      "equation": "x_{t+1}=f_{z_t}(x_t)+epsilon_t"
    },

    "regimes": [
      {
        "id": "growth",

        "transition": "x_{t+1}=1.1*x_t+epsilon_t"
      },
      {
        "id": "stabilization",

        "transition": "x_{t+1}=0.8*x_t+epsilon_t"
      },
      {
        "id": "inversion",

        "transition": "x_{t+1}=-0.5*x_t+epsilon_t"
      }
    ],

    "observation": {
      "equation": "y_t=h_{z_t}(x_t)+eta_t"
    }
  },

  "interfaces_checked": [
    {
      "interface_id": "I_observation",

      "operator": {
        "equation": "O_I(x_t)=y_t"
      },

      "tests": [
        {
          "target": "T_current_state_estimation",

          "factorization": "conditional"
        },
        {
          "target": "T_regime_identification",

          "factorization": false
        },
        {
          "target": "T_future_prediction_under_shift",

          "factorization": false
        }
      ],

      "counterexample": {
        "state_A": {
          "value": 1.0,

          "regime": "growth"
        },

        "state_B": {
          "value": 1.0,

          "regime": "inversion"
        },

        "observation_relation": {
          "same_observation": true
        },

        "future_relation": {
          "different": true
        }
      },

      "result": {
        "factorization": false,

        "failure_type": "hidden_regime_aliasing"
      }
    },

    {
      "interface_id": "I_history_window",

      "operator": {
        "equation": "O_I(x_t)=(y_{t-k},...,y_t)"
      },

      "window_tests": [
        {
          "window": 5,

          "regime_detection": "partial",

          "future_prediction": "conditional",

          "factorization": "weak"
        },
        {
          "window": 100,

          "regime_detection": "strong",

          "future_prediction": "improved",

          "factorization": "conditional"
        }
      ],

      "counterexample": {
        "failure": "historical_contamination",

        "description": "Long histories contain evidence from obsolete regimes."
      },

      "result": {
        "factorization": "window_dependent",

        "failure_type": "stale_information"
      }
    },

    {
      "interface_id": "I_stationary_model",

      "operator": {
        "equation": "O_I(x_t)=P(x_{t+1}|x_t)"
      },

      "tests": [
        {
          "target": "T_future_prediction_under_shift",

          "before_shift": {
            "factorization": true
          },

          "after_shift": {
            "factorization": false
          }
        },
        {
          "target": "T_model_validity_estimation",

          "factorization": false
        }
      ],

      "counterexample": {
        "assumed_transition": "x_{t+1}=1.1*x_t",

        "true_transition": "x_{t+1}=0.8*x_t",

        "resulting_error": "systematic"
      },

      "result": {
        "factorization": false,

        "failure_type": "model_obsolescence"
      }
    },

    {
      "interface_id": "I_change_detector",

      "operator": {
        "equation": "O_I(x_t)=P(z_t|y_{0:t})"
      },

      "tests": [
        {
          "target": "T_regime_identification",

          "factorization": true
        },
        {
          "target": "T_model_validity_estimation",

          "factorization": true
        }
      ],

      "limitations": [
        "weak_distribution_shift",
        "insufficient_observations"
      ],

      "result": {
        "factorization": true,

        "failure_type": null
      }
    },

    {
      "interface_id": "I_adaptive_belief",

      "operator": {
        "equation": "O_I(x_t)=P(x_t,z_t|y_{0:t})"
      },

      "tests": [
        {
          "target": "T_current_state_estimation",

          "factorization": true
        },
        {
          "target": "T_regime_identification",

          "factorization": true
        },
        {
          "target": "T_future_prediction_under_shift",

          "factorization": true
        },
        {
          "target": "T_model_validity_estimation",

          "factorization": true
        }
      ],

      "assumptions": [
        "regime model contains true dynamics",
        "belief update is calibrated"
      ],

      "result": {
        "factorization": true,

        "failure_type": null
      }
    },

    {
      "interface_id": "I_intervention",

      "operator": {
        "equation": "O_I(x_t,u_t)=P(y_{t+1}|do(u_t),x_t)"
      },

      "tests": [
        {
          "target": "T_counterfactual_regime_response",

          "factorization": true
        },
        {
          "target": "T_regime_identification",

          "factorization": true
        }
      ],

      "limitations": [
        "restricted_control",
        "unsafe_exploration"
      ],

      "result": {
        "factorization": true,

        "failure_type": null
      }
    }
  ],

  "failure_taxonomy": {
    "hidden_regime_aliasing": {
      "definition": "Different causal regimes produce identical observations."
    },

    "historical_contamination": {
      "definition": "Past information reduces accuracy after regime changes."
    },

    "model_obsolescence": {
      "definition": "A previously valid model becomes invalid."
    },

    "adaptation_delay": {
      "definition": "The interface updates after consequences are observed."
    },

    "false_stability": {
      "definition": "The system incorrectly assumes unchanged dynamics."
    }
  },

  "global_findings": {
    "stationary_factorization": {
      "insufficient": true,

      "reason": "Transition function is time-dependent."
    },

    "adaptive_factorization": {
      "required_variables": [
        "state",
        "regime",
        "uncertainty"
      ]
    },

    "main_boundary": {
      "description": "The minimum sufficient interface expands when the validity of the model becomes a target."
    }
  },

  "comparison_to_previous_benchmarks": {
    "linear": {
      "failure": "representation collapse"
    },

    "hidden_state": {
      "failure": "latent variable omission"
    },

    "delay": {
      "failure": "temporal misalignment"
    },

    "stochastic": {
      "failure": "distribution collapse"
    },

    "nonstationary": {
      "failure": "validity collapse"
    }
  },

  "validation": {
    "factorization_tests_completed": true,

    "regime_shift_cases_checked": true,

    "adaptive_interfaces_verified": true
  },

  "decision": {
    "status": "PASSED",

    "meaning": "Nonstationary factorization boundaries verified across candidate interfaces."
  },

  "notes": [
    "The key failure mode is not lack of data but loss of awareness that the world model changed.",
    "A sufficient interface must represent uncertainty about its own assumptions.",
    "Adaptive belief and intervention-based interfaces preserve causal distinctions across regime changes."
  ]
}
