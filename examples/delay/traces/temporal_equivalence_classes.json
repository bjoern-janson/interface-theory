{
  "example_id": "delay",
  "artifact_type": "temporal_equivalence_classes",
  "protocol_version": "INTERFACE_THEORY_v0.1",

  "purpose": {
    "description": "Represent equivalence classes induced by delayed observation interfaces.",
    "role": "Measure when temporal compression merges states with different causal futures.",
    "usage": [
      "factorization verification",
      "minimal interface analysis",
      "delay boundary characterization"
    ]
  },

  "formal_definition": {
    "observation_equivalence": {
      "condition": "O_I(x_a)=O_I(x_b)"
    },

    "target_equivalence": {
      "condition": "L(x_a)=L(x_b)"
    },

    "interface_sufficiency": {
      "condition": "observation_classes refine target_classes"
    },

    "failure": {
      "condition": "exists class C where |{L(x):x in C}| > 1"
    }
  },

  "system": {
    "state_variable": "x_t",

    "observation": {
      "equation": "y_t=x_{t-2}",

      "delay": 2
    },

    "dynamics": {
      "equation": "x_{t+1}=1.2x_t"
    }
  },

  "equivalence_classes": [
    {
      "class_id": "E0_single_delayed_observation",

      "interface": "I_delayed_observation",

      "observation_value": 1.0,

      "members": [
        {
          "trace_id": "delayed_signal_A",

          "state_time": 0,

          "current_state": 1.44
        },
        {
          "trace_id": "delayed_signal_B",

          "state_time": 0,

          "current_state": 1.96
        }
      ],

      "class_properties": {
        "observation_equivalent": true,

        "target_equivalent": false,

        "impure": true
      },

      "failure": {
        "target": "T_current_state",

        "type": "temporal_aliasing"
      }
    },

    {
      "class_id": "E1_short_history_window",

      "interface": "I_history_window_1",

      "history": [
        1.0
      ],

      "members": [
        {
          "trace_id": "delayed_signal_A",

          "current_state": 1.44
        },
        {
          "trace_id": "delayed_signal_B",

          "current_state": 1.96
        }
      ],

      "class_properties": {
        "observation_equivalent": true,

        "target_equivalent": false,

        "impure": true
      },

      "failure": {
        "target": "T_current_state",

        "type": "insufficient_temporal_context"
      }
    },

    {
      "class_id": "E2_extended_history_window",

      "interface": "I_history_window_5",

      "history": [
        1.0,
        1.2,
        1.44,
        1.728,
        2.0736
      ],

      "members": [
        {
          "trace_id": "delayed_signal_A",

          "current_state": 2.985984
        }
      ],

      "class_properties": {
        "observation_equivalent": false,

        "target_equivalent": true,

        "pure": true
      },

      "result": "identifiable"
    },

    {
      "class_id": "E3_model_augmented_interface",

      "interface": "I_predictive_model",

      "observation_signature": {
        "delayed_state": 1.0,

        "delay": 2,

        "transition_factor": 1.2
      },

      "members": [
        {
          "trace_id": "delayed_signal_A",

          "reconstructed_state": 1.44
        }
      ],

      "class_properties": {
        "observation_equivalent": true,

        "target_equivalent": true,

        "pure": true
      },

      "result": "identifiable_under_model"
    }
  ],

  "partition_analysis": {
    "raw_delay_interface": {
      "partition": "coarse",

      "target_collisions": true,

      "interpretation": "Different present states collapse into identical delayed representations."
    },

    "history_interface": {
      "partition": "refined",

      "target_collisions": "window_length_dependent",

      "interpretation": "Temporal context progressively separates trajectories."
    },

    "predictive_interface": {
      "partition": "target_aligned",

      "target_collisions": false,

      "interpretation": "Model-based compensation restores causal alignment."
    }
  },

  "delay_signature": {
    "information_status": {
      "available": true,

      "destroyed": false
    },

    "alignment_status": {
      "available_time": "past",

      "required_time": "present"
    },

    "core_failure": "temporal_misalignment"
  },

  "comparison_to_hidden_state": {
    "hidden_state_equivalence": {
      "cause": "different latent states share observation"
    },

    "delay_equivalence": {
      "cause": "different current states share delayed observation"
    },

    "common_condition": {
      "statement": "same interface output does not guarantee same target"
    }
  },

  "minimal_interface_conclusion": {
    "target": "T_current_state",

    "minimal_sufficient_candidates": [
      "I_delay_compensated",
      "I_history_window_with_sufficient_context",
      "I_predictive_model"
    ],

    "boundary": "depends_on_available_assumptions"
  },

  "validation": {
    "equivalence_classes_defined": true,

    "target_purity_checked": true,

    "partition_refinement_verified": true
  },

  "decision": {
    "status": "READY",

    "meaning": "Temporal equivalence partition for delayed observation identifiability."
  },

  "notes": [
    "Equivalence classes expose exactly where an interface loses causal resolution.",
    "Delay increases equivalence-class size by collapsing states across time.",
    "A sufficient interface must restore distinctions relevant to the target."
  ]
}
