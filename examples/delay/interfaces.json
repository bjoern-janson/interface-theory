{
  "example_id": "delay",
  "artifact_type": "interface_definitions",
  "protocol_version": "INTERFACE_THEORY_v0.1",

  "purpose": {
    "description": "Define candidate observation interfaces for evaluating temporal identifiability under delayed information.",
    "role": "Compare raw delayed access against interfaces capable of compensating for temporal displacement.",
    "principle": "An interface is sufficient only if delayed observations preserve target-relevant distinctions."
  },

  "system_reference": {
    "file": "system.json",

    "state_symbol": "x_t",

    "observation_equation": "y_t=x_{t-tau}",

    "default_delay": 2
  },

  "interfaces": [
    {
      "interface_id": "I_delayed_observation",

      "name": "Raw delayed observation",

      "description": "The observer receives only the delayed measurement stream.",

      "input": {
        "signal": "y_t",

        "delay_metadata": false,

        "history": false,

        "model": false,

        "control": false
      },

      "observation_operator": {
        "equation": "O(x_t)=x_{t-tau}"
      },

      "information_content": {
        "past_state": true,

        "current_state": false,

        "future_state": false
      },

      "complexity": {
        "observation_dimension": 1,

        "memory_requirement": 0,

        "computation_requirement": "none"
      },

      "expected_targets": {
        "current_state": "insufficient",

        "past_state": "sufficient",

        "future_state": "insufficient"
      },

      "failure_mode": "temporal_misalignment",

      "status": "baseline_failure"
    },

    {
      "interface_id": "I_delay_compensated",

      "name": "Delay-aware observation",

      "description": "The observer receives delayed measurements together with the delay value.",

      "input": {
        "signal": "y_t",

        "delay_metadata": true,

        "history": false,

        "model": false,

        "control": false
      },

      "observation_operator": {
        "equation": "O(x_t)=(x_{t-tau},tau)"
      },

      "information_content": {
        "past_state": true,

        "current_state": "conditional",

        "future_state": false
      },

      "complexity": {
        "observation_dimension": 2,

        "memory_requirement": 0,

        "computation_requirement": "low"
      },

      "expected_targets": {
        "current_state": "requires_dynamics",

        "past_state": "sufficient",

        "future_state": "requires_dynamics"
      },

      "failure_mode": "missing_transition_model",

      "status": "conditionally_sufficient"
    },

    {
      "interface_id": "I_history_window",

      "name": "Temporal history interface",

      "description": "The observer receives a window of delayed observations.",

      "input": {
        "signal": "(y_{t-k},...,y_t)",

        "delay_metadata": false,

        "history": true,

        "model": false,

        "control": false
      },

      "observation_operator": {
        "equation": "O(x_t)=(x_{t-k-tau},...,x_{t-tau})"
      },

      "parameters": {
        "window_sizes": [
          1,
          2,
          5,
          10
        ]
      },

      "information_content": {
        "past_state": true,

        "current_state": "window_dependent",

        "future_state": "window_dependent"
      },

      "complexity": {
        "observation_dimension": "k",

        "memory_requirement": "k",

        "computation_requirement": "medium"
      },

      "expected_targets": {
        "current_state": "conditional",

        "future_state": "conditional"
      },

      "failure_mode": "insufficient_temporal_context",

      "status": "history_dependent"
    },

    {
      "interface_id": "I_predictive_model",

      "name": "Model-based delay compensation",

      "description": "The observer combines delayed observations with a known transition model.",

      "input": {
        "signal": "y_t",

        "delay_metadata": true,

        "history": false,

        "model": true,

        "control": false
      },

      "observation_operator": {
        "equation": "O(x_t)=(x_{t-tau},tau,A)"
      },

      "reconstruction": {
        "method": "forward_prediction",

        "equation": "x_hat_t=A^tau y_t"
      },

      "information_content": {
        "past_state": true,

        "current_state": true,

        "future_state": true
      },

      "complexity": {
        "observation_dimension": 3,

        "memory_requirement": 0,

        "computation_requirement": "high"
      },

      "expected_targets": {
        "current_state": "sufficient",

        "future_state": "sufficient"
      },

      "failure_mode": "model_mismatch",

      "status": "sufficient_under_assumptions"
    },

    {
      "interface_id": "I_intervention",

      "name": "Active temporal probing",

      "description": "The observer applies controlled perturbations to infer current state despite delayed feedback.",

      "input": {
        "signal": "delayed_response",

        "delay_metadata": true,

        "history": true,

        "model": false,

        "control": true
      },

      "observation_operator": {
        "equation": "O(x_t,u_t)=response(x_t,do(u_t))"
      },

      "information_content": {
        "causal_state": true,

        "current_state": "improved",

        "future_state": "improved"
      },

      "complexity": {
        "observation_dimension": "variable",

        "memory_requirement": "variable",

        "control_requirement": "nonzero"
      },

      "expected_targets": {
        "current_state": "improved",

        "future_state": "improved"
      },

      "failure_mode": "limited_control_authority",

      "status": "active_identification"
    }
  ],

  "comparison_matrix": {
    "targets": [
      "current_state",
      "past_state",
      "future_state"
    ],

    "ranking": {
      "I_delayed_observation": 1,

      "I_delay_compensated": 2,

      "I_history_window": 3,

      "I_intervention": 4,

      "I_predictive_model": 5
    }
  },

  "minimality_expectation": {
    "statement": "The minimal sufficient interface depends on target horizon and available assumptions.",

    "examples": {
      "past_state": "I_delayed_observation",

      "current_state": "I_history_window_or_I_predictive_model",

      "future_state": "I_predictive_model"
    }
  },

  "validation": {
    "interfaces_defined": true,

    "information_boundaries_defined": true,

    "failure_modes_defined": true
  },

  "decision": {
    "status": "READY",

    "meaning": "Candidate interfaces for delayed temporal identifiability experiments."
  },

  "notes": [
    "Delay is treated as an interface constraint, not merely a noise source.",
    "Compensation requires additional assumptions such as history, models, or interventions.",
    "The benchmark measures whether the interface preserves causal timing."
  ]
}
