{
  "example_id": "delay",
  "artifact_type": "counterexamples",
  "protocol_version": "INTERFACE_THEORY_v0.1",

  "purpose": {
    "description": "Collect adversarial examples where delayed interfaces collapse states with different target values.",
    "role": "Demonstrate temporal non-identifiability failures.",
    "principle": "If delayed observations are equivalent but targets differ, the interface cannot support the target."
  },

  "formal_condition": {
    "failure": {
      "observation_equivalence": "O_I(x_a)=O_I(x_b)",

      "target_divergence": "L(x_a)!=L(x_b)"
    },

    "interpretation": "The interface loses temporal alignment required for the target."
  },

  "system": {
    "dynamics": {
      "equation": "x_{t+1}=1.2x_t"
    },

    "observation": {
      "equation": "y_t=x_{t-2}"
    },

    "delay": 2
  },

  "counterexamples": [
    {
      "id": "CE_delay_current_state_001",

      "name": "Same delayed observation, different current state",

      "interface": "I_delayed_observation",

      "states": [
        {
          "state_id": "A",

          "trajectory": {
            "x_{t-2}": 1.0,

            "x_t": 1.44
          }
        },
        {
          "state_id": "B",

          "trajectory": {
            "x_{t-2}": 1.0,

            "x_t": 2.88
          }
        }
      ],

      "observation_comparison": {
        "A": 1.0,

        "B": 1.0,

        "equivalent": true
      },

      "target_comparison": {
        "target": "T_current_state",

        "A": 1.44,

        "B": 2.88,

        "equivalent": false
      },

      "result": {
        "factorization": false,

        "failure_type": "temporal_aliasing"
      }
    },

    {
      "id": "CE_delay_future_prediction_001",

      "name": "Delayed equivalence causes future prediction failure",

      "interface": "I_delayed_observation",

      "states": [
        {
          "state_id": "A",

          "current_state": 1.0,

          "future_state": 1.2
        },
        {
          "state_id": "B",

          "current_state": 2.0,

          "future_state": 2.4
        }
      ],

      "observation_comparison": {
        "delayed_observation_A": 0.833333,

        "delayed_observation_B": 0.833333,

        "equivalent": true
      },

      "target_comparison": {
        "target": "T_future_state",

        "A": 1.2,

        "B": 2.4,

        "equivalent": false
      },

      "result": {
        "factorization": false,

        "failure_type": "prediction_ambiguity"
      }
    },

    {
      "id": "CE_delay_history_insufficient_001",

      "name": "Short history cannot recover temporal alignment",

      "interface": "I_history_window_1",

      "history_window": 1,

      "states": [
        {
          "state_id": "A",

          "history": [
            1.0
          ],

          "current": 1.44
        },
        {
          "state_id": "B",

          "history": [
            1.0
          ],

          "current": 2.88
        }
      ],

      "observation_comparison": {
        "history_A": [
          1.0
        ],

        "history_B": [
          1.0
        ],

        "equivalent": true
      },

      "target_comparison": {
        "target": "T_current_state",

        "equivalent": false
      },

      "result": {
        "factorization": false,

        "failure_type": "insufficient_temporal_context"
      }
    },

    {
      "id": "CE_delay_model_mismatch_001",

      "name": "Incorrect dynamics create false compensation",

      "interface": "I_predictive_model",

      "assumed_model": {
        "A": 1.2
      },

      "true_model": {
        "A": 1.3
      },

      "observation": {
        "delayed_state": 1.0
      },

      "reconstruction": {
        "estimated_current": 1.44,

        "true_current": 1.69
      },

      "target_comparison": {
        "target": "T_current_state",

        "equivalent": false
      },

      "result": {
        "factorization": false,

        "failure_type": "model_dependence"
      }
    },

    {
      "id": "CE_delay_action_timing_001",

      "name": "Correct information arrives after decision point",

      "interface": "I_delayed_observation",

      "scenario": {
        "decision_time": "t",

        "feedback_arrival": "t+2"
      },

      "states": [
        {
          "state_id": "A",

          "optimal_action": "left"
        },
        {
          "state_id": "B",

          "optimal_action": "right"
        }
      ],

      "observation_comparison": {
        "available_information": "identical",

        "equivalent": true
      },

      "target_comparison": {
        "target": "T_decision_optimal_action",

        "equivalent": false
      },

      "result": {
        "factorization": false,

        "failure_type": "decision_time_mismatch"
      }
    }
  ],

  "summary": {
    "total_counterexamples": 5,

    "failure_modes": [
      "temporal_aliasing",
      "prediction_ambiguity",
      "insufficient_temporal_context",
      "model_dependence",
      "decision_time_mismatch"
    ],

    "central_result": "Delayed interfaces fail when multiple present causal states share the same delayed representation."
  },

  "comparison_to_hidden_state": {
    "shared_pattern": {
      "condition": "same_interface_output_different_target"
    },

    "difference": {
      "hidden_state": "information hidden in latent dimensions",

      "delay": "information shifted across time"
    }
  },

  "validation": {
    "counterexamples_defined": true,

    "failure_conditions_verified": true,

    "temporal_boundary_covered": true
  },

  "decision": {
    "status": "READY",

    "meaning": "Counterexample suite for delayed interface non-identifiability."
  },

  "notes": [
    "The strongest counterexamples preserve identical observations while changing only temporal alignment.",
    "Delay creates a causal accessibility problem rather than an information quantity problem.",
    "The benchmark distinguishes sensing limitations from timing limitations."
  ]
}
