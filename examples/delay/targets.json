{
  "example_id": "delay",
  "artifact_type": "target_definitions",
  "protocol_version": "INTERFACE_THEORY_v0.1",

  "purpose": {
    "description": "Define prediction and reconstruction targets for delayed observation identifiability experiments.",
    "role": "Specify which properties must factor through each candidate interface.",
    "principle": "An interface succeeds only if observation-equivalent states remain target-equivalent."
  },

  "formal_definition": {
    "system_state": {
      "symbol": "x_t"
    },

    "interface_output": {
      "symbol": "O(x_t)"
    },

    "target": {
      "symbol": "L(x_t)"
    },

    "factorization_condition": {
      "statement": "exists L_hat such that L=L_hat o O",

      "equivalent_condition": "O(x_a)=O(x_b) => L(x_a)=L(x_b)"
    }
  },

  "targets": [
    {
      "target_id": "T_delayed_state",

      "name": "Recover delayed state",

      "definition": {
        "symbol": "L_0(x_t)",

        "expression": "x_{t-tau}"
      },

      "description": "Recover the state represented by the delayed observation itself.",

      "difficulty": "low",

      "required_information": [
        "delayed observation"
      ],

      "expected_interfaces": {
        "I_delayed_observation": "sufficient",

        "I_delay_compensated": "sufficient",

        "I_history_window": "sufficient",

        "I_predictive_model": "sufficient"
      }
    },

    {
      "target_id": "T_current_state",

      "name": "Recover current state",

      "definition": {
        "symbol": "L_1(x_t)",

        "expression": "x_t"
      },

      "description": "Infer the present state despite delayed observations.",

      "difficulty": "medium",

      "required_information": [
        "delay compensation",
        "history",
        "or transition model"
      ],

      "expected_interfaces": {
        "I_delayed_observation": "insufficient",

        "I_delay_compensated": "conditional",

        "I_history_window": "conditional",

        "I_predictive_model": "sufficient"
      },

      "failure_mode": "temporal_aliasing"
    },

    {
      "target_id": "T_future_state",

      "name": "Predict future state",

      "definition": {
        "symbol": "L_2(x_t)",

        "expression": "x_{t+k}"
      },

      "parameters": {
        "forecast_horizon": [
          1,
          5,
          10
        ]
      },

      "description": "Predict future evolution from delayed evidence.",

      "difficulty": "high",

      "required_information": [
        "current state estimate",
        "dynamics"
      ],

      "expected_interfaces": {
        "I_delayed_observation": "insufficient",

        "I_delay_compensated": "conditional",

        "I_history_window": "conditional",

        "I_predictive_model": "sufficient"
      }
    },

    {
      "target_id": "T_state_transition",

      "name": "Identify transition dynamics",

      "definition": {
        "symbol": "L_3(x_t)",

        "expression": "A"
      },

      "description": "Determine the causal transition rule producing future states.",

      "difficulty": "high",

      "required_information": [
        "multiple observations",
        "temporal variation"
      ],

      "expected_interfaces": {
        "I_delayed_observation": "insufficient",

        "I_history_window": "conditional",

        "I_predictive_model": "requires_learning",

        "I_intervention": "sufficient"
      },

      "failure_mode": "dynamics_nonidentifiability"
    },

    {
      "target_id": "T_decision_optimal_action",

      "name": "Choose action at current time",

      "definition": {
        "symbol": "L_4(x_t)",

        "expression": "argmax_a U(a,x_t)"
      },

      "description": "Select the correct action despite delayed feedback.",

      "difficulty": "very_high",

      "required_information": [
        "current state",
        "decision horizon",
        "utility model"
      ],

      "expected_interfaces": {
        "I_delayed_observation": "insufficient",

        "I_delay_compensated": "conditional",

        "I_history_window": "conditional",

        "I_predictive_model": "sufficient_under_model"
      },

      "failure_mode": "decision_time_mismatch"
    },

    {
      "target_id": "T_delay_parameter",

      "name": "Identify delay magnitude",

      "definition": {
        "symbol": "L_5(x_t)",

        "expression": "tau"
      },

      "description": "Determine temporal offset between state and observation.",

      "difficulty": "medium",

      "required_information": [
        "observation history"
      ],

      "expected_interfaces": {
        "I_delayed_observation": "insufficient",

        "I_delay_compensated": "given",

        "I_history_window": "sufficient",

        "I_predictive_model": "sufficient"
      }
    }
  ],

  "target_hierarchy": {
    "level_1": {
      "name": "Past reconstruction",

      "targets": [
        "T_delayed_state"
      ]
    },

    "level_2": {
      "name": "Present reconstruction",

      "targets": [
        "T_current_state"
      ]
    },

    "level_3": {
      "name": "Future prediction",

      "targets": [
        "T_future_state",
        "T_state_transition"
      ]
    },

    "level_4": {
      "name": "Adaptive control",

      "targets": [
        "T_decision_optimal_action"
      ]
    }
  },

  "identifiability_boundary": {
    "core_question": "Does delayed information preserve enough temporal structure for the target?",

    "failure_condition": {
      "same_observation": true,

      "different_target": true
    },

    "interpretation": "Temporal displacement can create apparent information loss."
  },

  "validation": {
    "targets_defined": true,

    "difficulty_levels_defined": true,

    "interface_expectations_defined": true,

    "factorization_conditions_defined": true
  },

  "decision": {
    "status": "READY",

    "meaning": "Target specification for delayed interface identifiability benchmark."
  },

  "notes": [
    "Targets distinguish recovering the past from reconstructing the present.",
    "Prediction requires more than delayed observation because future states depend on current alignment.",
    "Decision targets expose the practical cost of temporal misalignment."
  ]
}
