{
  "example_id": "F0_linear",
  "artifact_type": "system_definition",
  "protocol_version": "INTERFACE_THEORY_v0.1",
  "metadata": {
    "name": "Canonical Linear Dynamical System",
    "description": "Illustrative two-dimensional linear system for target-relative interface identifiability.",
    "purpose": "Provide the base environment for exact factorization, minimal interface search, and counterexample generation."
  },
  "system_class": {
    "family": "linear_dynamical_system",
    "stationarity": "stationary",
    "determinism": "deterministic",
    "state_dimension": 2,
    "observation_dimension_variable": true
  },
  "state": {
    "symbol": "x_t",
    "space": "R^2",
    "components": [
      {
        "index": 0,
        "name": "visible_component",
        "symbol": "x_1"
      },
      {
        "index": 1,
        "name": "latent_component",
        "symbol": "x_2"
      }
    ]
  },
  "dynamics": {
    "equation": "x_{t+1}=Ax_t",
    "transition_matrix": [
      [
        1,
        0.2
      ],
      [
        0,
        0.9
      ]
    ],
    "properties": {
      "linear": true,
      "time_invariant": true,
      "stable_component": true,
      "coupling": {
        "present": true,
        "description": "The second state coordinate influences the future first coordinate through off-diagonal coupling."
      }
    }
  },
  "initial_conditions": {
    "domain": "R^2",
    "sampling": {
      "distribution": "uniform",
      "range": [
        -1,
        1
      ]
    }
  },
  "observation_model": {
    "general_form": "y_t=Cx_t",
    "matrix_variable": true,
    "available_interfaces": [
      "I_full_state",
      "I_position_only",
      "I_hidden_dimension",
      "I_target_aligned_projection"
    ]
  },
  "trajectory_generation": {
    "default_horizon": 5,
    "trajectory": {
      "definition": "x_0,x_1,...,x_T",
      "recurrence": "x_{t+1}=Ax_t"
    }
  },
  "causal_structure": {
    "dependencies": {
      "x_2_t": [
        "x_1_{t+1}",
        "x_2_{t+1}"
      ],
      "x_1_t": [
        "x_1_{t+1}"
      ]
    },
    "interpretation": "The latent state cannot be ignored for long-horizon prediction."
  },
  "benchmark_targets": [
    "T_current_position",
    "T_future_position",
    "T_hidden_state",
    "T_full_trajectory"
  ],
  "expected_behavior": {
    "full_state_observation": {
      "factorization": true,
      "reason": "Complete state uniquely determines trajectory."
    },
    "partial_observation": {
      "factorization": "target-dependent",
      "reason": "Some targets require hidden dimensions."
    }
  },
  "validation": {
    "dimension_check": true,
    "matrix_consistency": true,
    "trajectory_rollout_verified": true,
    "target_dependency_verified": true
  },
  "decision": {
    "status": "ACTIVE",
    "role": "Baseline environment for Interface Theory experiments."
  },
  "notes": [
    "This system is intentionally minimal: partial interfaces can create target-relevant ambiguity.",
    "The off-diagonal transition term makes coordinate-only future prediction insufficient.",
    "A target-aligned scalar readout can still identify the scalar future-position target."
  ]
}
