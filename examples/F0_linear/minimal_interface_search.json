{
  "example_id": "F0_linear",
  "artifact_type": "minimal_interface_search",
  "protocol_version": "INTERFACE_THEORY_v0.1",

  "purpose": {
    "description": "Search the interface space for the lowest-cost observation boundary that preserves target identifiability.",
    "role": "Determine minimal sufficient interfaces rather than maximizing observation bandwidth.",
    "principle": "Find the smallest interface whose observation equivalence classes refine target equivalence classes."
  },

  "formal_problem": {
    "objective": {
      "symbol": "min C(O)",

      "description": "Minimize interface complexity."
    },

    "constraint": {
      "statement": "exists L_hat such that L = L_hat o O",

      "equivalent_condition": "O(x_a)=O(x_b) => L(x_a)=L(x_b)"
    },

    "search_space": {
      "family": "linear_observation_interfaces",

      "form": "O_C(x)=Cx",

      "dimensions_tested": [
        1,
        2
      ]
    }
  },

  "system": {
