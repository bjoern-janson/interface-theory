{
  "gate_id": "GATE-001",
  "protocol_version": "CMI_v0.1",
  "artifact_type": "behavior_probe_results",

  "probe": {
    "name": "behavioral_trace_probe",
    "purpose": "Test whether passive behavioral observations identify target-relevant differences",
    "interface_layer": "behavior_only"
  },

  "systems": [
    "A",
    "B"
  ],

  "target_access": {
    "available": false,
    "target_used_during_probe": false,
    "target_used_for_feature_generation": false
  },

  "observations": {
    "system_A": {
      "trace": [
        {
          "step": 0,
          "input": "initial_condition",
          "output": -1
        },
        {
          "step": 1,
          "input": "probe_1",
          "output": 0
        },
        {
          "step": 2,
          "input": "probe_2",
          "output": 1
        }
      ],
      "summary_vector": [
        -1,
        0,
        1
      ]
    },

    "system_B": {
      "trace": [
        {
          "step": 0,
          "input": "initial_condition",
          "output": -1
        },
        {
          "step": 1,
          "input": "probe_1",
          "output": 0
        },
        {
          "step": 2,
          "input": "probe_2",
          "output": 1
        }
      ],
      "summary_vector": [
        -1,
        0,
        1
      ]
    }
  },

  "comparison": {
    "trace_equal": true,
    "summary_equal": true,
    "behavioral_equivalence_candidate": true
  },

  "classification_test": {
    "task": "predict target class from behavioral trace",
    "classes": [
      "HIGH",
      "LOW"
    ],
    "classifier_family": "nonparametric_probe_classifier",
    "features": [
      "observed outputs only"
    ],

    "result": {
      "auc": 0.5,
      "accuracy": 0.5,
      "above_chance": false
    }
  },

  "identifiability": {
    "observation_map": "O_behavior",
    "result": "NON_IDENTIFYING",
    "reason": "Target-different systems share identical behavioral observations"
  },

  "failure_check": {
    "condition": "exists A,B: O(A)=O(B) and L(A)!=L(B)",
    "triggered": true
  },

  "decision": {
    "behavior_channel_sufficient": false,
    "gate_progression": "BLOCKED",
    "next_allowed_action": "analyze interface insufficiency"
  },

  "validation": {
    "trace_integrity": true,
    "label_separation": true,
    "protocol_compliant": true
  },

  "notes": [
    "This file records the passive behavior probe only.",
    "No intervention, recurrence, counterfactual, or privileged pathway information is included.",
    "Failure is attributed to the observation interface, not to the target definition."
  ]
}
