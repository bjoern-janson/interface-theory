      "statement": "phi(T) belongs to rowspace(X_T)",

      "verified": true
    },

    "equivalent_condition": {
      "statement": "ker(X_T) subseteq ker(phi(T)^T)",

      "verified": true
    },

    "factorization": {
      "exists": true,

      "statement": "L = L_hat o O"
    }
  },

